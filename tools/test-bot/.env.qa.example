# Use only with: docker compose --env-file .env.qa -f docker-compose.qa.yml ...
# Keep .env.qa local: it contains QA credentials and is ignored by Git.
QA_GAME_WS_URL=ws://host.docker.internal:9501/
QA_SP_GAME_LOGIN=
QA_SP_GAME_PASSWORD=
QA_CABINET_EMAIL=
CABINET_API_URL=https://cabinet.sp-game.ru
GAME_WORLD_ID=sp-game-dev
QA_BOT_API_TOKEN=replace-with-a-long-random-token
QA_BOT_API_PORT=8096
QA_BOT_REQUEST_TIMEOUT=15
QA_BOT_MAX_RUN_SECONDS=86400

QA_FOREIGN_LOGIN=
QA_FOREIGN_PASSWORD=
QA_FOREIGN_CABINET_EMAIL=
QA_FOREIGN_BOT_API_TOKEN=replace-with-another-long-random-token
QA_FOREIGN_BOT_API_PORT=8097
