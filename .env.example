# Database Configuration
DB_HOST=your_db_host
DB_PORT=3306
DB_READ_TIMEOUT=5
DB_NAME=your_db_name
DB_USER=your_db_user
DB_PASS=your_db_password
DB_PREFIX=uni1_

# Server Configuration
WS_HOST=0.0.0.0
WS_PORT=9501
# Бюджет отправки подписок: каждые 50мс, не более 64 DTO или 10мс за проход.
# Граница мягкая: уже начатое построение одного DTO не прерывается.
WS_PUSH_MAX_PER_PASS=64
WS_PUSH_BUDGET_MS=10
SP_GAME_CAPACITY_PROFILE=development
# Буфер всех наблюдателей, включая offline: development1024/target32768.
# Необязательный технический предел от1 до бюджета профиля, не игровой лимит.
# SENSOR_CONTACT_VIEWERS_LIMIT=1024
# Подготовка контактов в тике: порции кандидатов, мягкий бюджет времени.
# Незавершённый обход продолжается в следующем тике, без повторного начала.
SENSOR_SCAN_MAX_STEPS=1024
SENSOR_SCAN_BUDGET_MS=5
# JSON наблюдений одного игрока до сжатия (2..1048576 байт).
# При переполнении весь новый результат отбрасывается, прежний снимок стареет штатно.
SENSOR_SCAN_MAX_BYTES=1048576
# Интервал фоновых снимков; при аварии откат к последнему успешному сохранению.
# Штатная остановка сохраняет финальное состояние, ошибки БД могут увеличить окно потерь.
GAME_SAVE_INTERVAL_SECONDS=30
GAME_SAVE_SNAPSHOT_MAX_MIB=128
# Только межсерверные запросы; публичный адрес клиентов не меняет.
# HTTP допускается для кабинета на этом же хосте; между хостами используйте HTTPS.
CABINET_WORLD_INTERNAL_URL=

# Security
JWT_SECRET=your_jwt_secret_here_change_this_in_production
ENCRYPTION_KEY=your_encryption_key_here_change_this_in_production

# Game Configuration
GAME_NAME=SP-Game

# Logging
LOG_FILE=./logs/game.log           # путь к файлу логов
LOG_ROTATION_MODE=size             # options: none, size, daily
LOG_MAX_SIZE=1048576               # максимальный размер файла в байтах (1 MB), актуально при size
LOG_DATE_FORMAT=H:i:s d.m.y        # формат даты для логов
LOG_LEVEL=2                        # уровень логирования

# General Date Format
DATE_FORMAT=H:i:s d.m.y

# Mail Configuration
MAIL_HOST=smtp.example.com          # SMTP сервер
MAIL_PORT=587                        # Порт SMTP
MAIL_SMTP_AUTH=true                  # true если требуется авторизация
MAIL_USERNAME=your_smtp_username     # Логин для SMTP
MAIL_PASSWORD=your_smtp_password     # Пароль для SMTP
MAIL_ENCRYPTION=tls                  # ssl / tls / пусто для нешифрованного соединения
MAIL_FROM_ADDRESS=no-reply@example.com   # Адрес отправителя
MAIL_FROM_NAME="SP-Game"                 # Имя отправителя
EMAIL_RESEND_COOLDOWN=60                      # Через сколько можно отправить повторное сообщение
# PIN Code Configuration
PIN_LENGTH=6     # длина PIN-кода для всех случаев генерации 4-8
